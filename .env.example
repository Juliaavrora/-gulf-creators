# Скопируйте в .env.local в корне репозитория и заполните.
# .env.local в git не попадает. Секреты в код не пишем.

# --- База данных (PostgreSQL 16) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gulf_creators?schema=public"

# --- Приложения ---
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Откуда сайт обращается к API из браузера (CORS), через запятую
WEB_ORIGIN="http://localhost:3000"
# Секрет подписи ссылок на медиа (обязателен в проде; сгенерировать: openssl rand -hex 32)
MEDIA_SIGNING_SECRET=
# Адрес API для запросов с сервера Next.js (если отличается от публичного)
API_URL="http://localhost:4000"

# --- Только для разработки и демо-стенда ---
# Демо-стенд (Railway): разрешает DEV_AUTH при NODE_ENV=production. Только тестовые данные!
DEMO_MODE=
# Пока нет входа через Clerk: зритель задаётся заголовком x-dev-user: <clerk_user_id>. В проде запрещено.
DEV_AUTH=true
# То же для сайта: показывает переключатель «войти как» (только разработка)
NEXT_PUBLIC_DEV_AUTH=true
# Папка с медиа для локальной разработки (по умолчанию apps/api/dev-media)
DEV_MEDIA_DIR=

# --- Clerk (аутентификация: телефон OTP, Google, Apple ID) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Stripe (Billing + Connect Express) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mux (видео, подписанное воспроизведение, DRM) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
