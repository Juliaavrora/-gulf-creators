{
  "name": "gulf-creators",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gulf/shared --filter @gulf/db build && pnpm --parallel --filter @gulf/web --filter @gulf/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @gulf/shared build && pnpm -r typecheck",
    "db:generate": "pnpm --filter @gulf/db generate",
    "db:validate": "pnpm --filter @gulf/db validate",
    "db:migrate": "pnpm --filter @gulf/db migrate:dev",
    "db:seed": "pnpm --filter @gulf/db build && pnpm --filter @gulf/db seed",
    "db:reset": "pnpm --filter @gulf/db reset && pnpm db:seed",
    "test": "pnpm -r --if-present test"
  }
}
