{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @gulf/api... build",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @gulf/db exec prisma migrate deploy && pnpm --filter @gulf/db seed && node apps/api/dist/main.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
